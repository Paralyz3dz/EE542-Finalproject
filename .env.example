# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/taxagent
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda

# --- OpenAI: chat agent (/api/chat) and the interview note reader (src/llm/normalize.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_EXTRACT_MODEL=gpt-4o-mini

# --- Ollama: query embeddings for retrieval (src/rag/retriever.py)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Guided interview switches: on / off
# off = no retrieval (no DB / Ollama needed; guides show no official text)
TAX_AGENT_RETRIEVAL=on
# off = exact answers only, never call the model
TAX_AGENT_LLM=on

